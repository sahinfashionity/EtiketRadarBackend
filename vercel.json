{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index"
    },
    {
      "source": "/v1/extract-label",
      "destination": "/api/v1/extract-label"
    },
    {
      "source": "/v1/product-search",
      "destination": "/api/v1/product-search"
    },
    {
      "source": "/v1/debug",
      "destination": "/api/v1/debug"
    }
  ]
}
